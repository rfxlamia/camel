#!/usr/bin/env sh
set -e

echo "🔍 Checking staged files..."
if [ -z "$(git diff --cached --name-only --diff-filter=ACMR)" ]; then
	echo "✓ Nothing staged, skipping"
	exit 0
fi

PARTIAL_STAGED='^[^ ?!][^ ?!]'
if git status --porcelain | grep -q "$PARTIAL_STAGED"; then
	echo "ERROR: Partially staged files. Stage or stash the unstaged hunks before commit." >&2
	git status --porcelain | grep "$PARTIAL_STAGED" >&2
	exit 1
fi

set +e
OUTPUT=$(./node_modules/.bin/biome check --write --staged 2>&1)
STATUS=$?
set -e
echo "$OUTPUT"
if [ $STATUS -ne 0 ]; then
	if echo "$OUTPUT" | grep -q "No files were processed"; then
		echo "ℹ No Biome-processable files staged, skipping"
		exit 0
	fi
	exit $STATUS
fi
git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 git add --

echo "✓ Pre-commit passed (staged-only)"
