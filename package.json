{
	"name": "camel-kanban",
	"private": true,
	"version": "0.1.0",
	"engines": {
		"node": ">=22"
	},
	"description": "Camel — Agentic Kanban",
	"workspaces": [
		"client",
		"server"
	],
	"scripts": {
		"dev": "npm run dev --workspace=server & wait-on tcp:localhost:3001 && npm run dev --workspace=client & wait",
		"dev:server": "npm run dev --workspace=server",
		"dev:client": "npm run dev --workspace=client",
		"db:up": "docker compose up -d db",
		"db:migrate": "npm run db:migrate --workspace=server",
		"db:seed": "npm run db:seed --workspace=server",
		"test": "npm run test:guards && npm run test --workspace=server && npm run test --workspace=client && npm run test:feature-modules",
		"test:guards": "node --test scripts/*.test.mjs",
		"test:feature-modules": "node --test scripts/feature-modules/*.test.mjs",
		"check:feature-modules": "node scripts/check-feature-modules.mjs",
		"check:inline-400": "node scripts/check-inline-400.mjs",
		"lint": "biome lint .",
		"lint:fix": "biome check --write .",
		"typecheck": "npm run typecheck --workspace=server && npm run typecheck --workspace=client",
		"build": "npm run build --workspace=server && npm run build --workspace=client",
		"check:mutation-routing": "node scripts/check-work-item-mutation-routing.mjs",
		"check:event-write-routing": "node scripts/check-event-write-routing.mjs",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"husky": "^9.1.7",
		"wait-on": "^9.0.10"
	}
}
